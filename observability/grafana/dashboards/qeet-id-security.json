        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(sign_ins_total{job=\"qeet-id\"}[5m])) * 300",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "succeeded, or the reason a sign-in was refused (a wrong credential is an expected answer, not a server error). MFA codes count under method *_mfa / mfa.",
