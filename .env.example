SERVICE_NAME=qeet-id
# One of: dev | local | prod — anything else refuses to start.
#   dev   developer workstation; production gates off, ephemeral keys allowed
#   local Local-tier runtime of the Qeet ID Kit (qeet-id-kit; DEV/TEST/STAGING);
#         every production gate on, APP_BASE_URL/LOGIN_BASE_URL must be
#         localhost or *.localhost
#   prod  production; APP_BASE_URL must be a public origin
SERVICE_ENV=dev
# Local environment, only with SERVICE_ENV=local: dev | test | staging (else empty).
SERVICE_PROFILE=
HTTP_PORT=4001
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536
LOG_LEVEL=info
# "json" forces JSON lines (pipe through jq for pretty-print); "text" forces colored logfmt; blank = auto.
LOG_FORMAT=json

# ── OpenTelemetry tracing (OTLP/HTTP → local collector) ───────────────────────
# Points at the otel-collector published by docker-compose (`make obs-up`).
# Blank disables tracing entirely: no exporter, no network, global no-op tracer.
# NOTE: if this is set but the collector is NOT running, the batch span
# processor logs periodic export failures — clear it or run `make obs-up`.
# NOTE: the signal path /v1/traces is REQUIRED here. tracing.Init passes this
# value to otlptracehttp.WithEndpointURL, which uses the URL verbatim and does
# NOT append the signal path the way the OTLP spec's base-URL convention does.
# Setting a bare http://localhost:4318 posts to "/" and every export 404s.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Head sampling ratio for root spans, 0..1. Keep 1 locally so every request is
# traced; lower it in staging/prod.
OTEL_TRACES_SAMPLER_RATIO=1

# Postgres connection string (matches docker-compose.yml); used for queries + migrations.
DB_URL=postgres://postgres:<password>@localhost:5001/qeet_id?sslmode=disable
# Outbox dispatcher publishes domain events here; blank = log-only.
NATS_URL=nats://127.0.0.1:4222
DB_MIN_CONNS=2
DB_MAX_CONNS=10
# Set false when cmd/worker runs as a separate deployment.
EMBEDDED_WORKERS=true

# Derives the secrets-vault key (no longer used for token signing).
JWT_SECRET=please-change-me-please-change-me
JWT_ISSUER=qeet-id
JWT_AUDIENCE=qeet-id
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
# ES256 EC P-256 private key (PEM). Blank in dev = ephemeral key; REQUIRED outside dev.
#   Generate: openssl ecparam -name prime256v1 -genkey -noout
JWT_SIGNING_KEY=
# Concatenated PEM public keys of retired signing keys, kept verifiable during rotation.
JWT_RETIRED_KEYS=
# Two-phase rotation: pre-stage the new JWT_SIGNING_KEY with false on all replicas,
# then set true to atomically activate it in the shared registry.
JWT_ACTIVATE_SIGNING_KEY=false
JWT_SIGNING_KEY_RETIRE_GRACE=720h
JWT_SIGNING_KEY_REFRESH_INTERVAL=5s
# base64 AES key (16/24/32 bytes) for the secrets vault. Blank in dev = ephemeral; REQUIRED outside dev.
#   Generate: openssl rand -base64 32
SECRETS_KEY=

# Breached-password check (HIBP range API). Needs network + fails open, so off by default;
# turn on for staging/prod. An offline common-password denylist always runs.
BREACHED_PASSWORD_CHECK=false
BREACHED_PASSWORD_MIN_COUNT=1

# Sign-in lockout. Failures to one account from one network lock it for that
# network: THRESHOLD failures, each within WINDOW of the last, lock for DURATION.
# These are the platform defaults; a tenant may set its own within the _MIN/_MAX
# bounds (whole minutes). THRESHOLD x ACCOUNT_MULTIPLIER failures from any
# networks lock the account everywhere. A network failing against SPRAY_ACCOUNTS
# accounts within SPRAY_WINDOW is refused password sign-in for SPRAY_BLOCK.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
LOGIN_LOCKOUT_THRESHOLD_MIN=3
LOGIN_LOCKOUT_THRESHOLD_MAX=20
LOGIN_LOCKOUT_WINDOW_MIN=1m
LOGIN_LOCKOUT_WINDOW_MAX=24h
LOGIN_LOCKOUT_DURATION_MIN=1m
LOGIN_LOCKOUT_DURATION_MAX=24h
LOGIN_LOCKOUT_ACCOUNT_MULTIPLIER=4
LOGIN_SPRAY_ACCOUNTS=30
LOGIN_SPRAY_WINDOW=15m
LOGIN_SPRAY_BLOCK=15m

# Number of reverse proxies in front of this server that APPEND to
# X-Forwarded-For (Caddy, nginx and ALB all append rather than replace).
#
# This decides how the client IP is resolved, and the client IP keys the per-IP
# login rate limiter and every audit record. X-Forwarded-For is caller-supplied,
# so the value is read POSITIONALLY from the right: the last N entries are the
# ones your proxies added, and the entry left of them is the real client.
#
#   0  (default, safe)  ignore X-Forwarded-For; use the transport peer.
#   1                   exactly one proxy (the usual single Caddy/nginx/ALB).
#
# Leave 0 when the process is reachable directly. Behind a proxy you MUST set
# the real hop count: too low and callers can forge their IP (bypassing the
# login limiter and forging audit entries); too high and every request is
# attributed to the proxy.
TRUSTED_PROXY_HOPS=0

# Browser origins allowed to call the API cross-origin (CORS).
#
# Includes the Qeet Developers portal (api.qeet.in) so its API reference can
# send requests to this server from a browser. Without it the portal's "Send"
# fails with "Failed to fetch" even though curl and Postman get 200 — those are
# not browsers and are not subject to the same-origin policy.
#   · https://api.qeet.in    the deployed portal
#   · http://localhost:3005  the portal run locally (`bun run dev`)
#
# A wildcard is rejected at startup: this API enables credentialed CORS, where
# `*` would let any site make authenticated requests. List origins explicitly.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3000,http://localhost:5173,http://localhost:3005,https://api.qeet.in

# Origin for links in emails. Dev: admin app (:3002) hosts /invite/accept.
APP_BASE_URL=http://localhost:3002

# Hosted login app origin — the OAuth authorize flow redirects here.
LOGIN_BASE_URL=http://localhost:3003

# ── Platform social login (console's own Qeet ID accounts, tenant-less) ─────
# "Continue with Google" on the console sign-in/sign-up. OFF until both are set.
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and add
# this authorized redirect URI: http://localhost:4001/v1/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra) app registration; add redirect URI (type "Web"):
# http://localhost:4001/v1/social/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# GitHub OAuth App (Settings → Developer settings → OAuth Apps → New). Set the
# Authorization callback URL to: http://localhost:4001/v1/social/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Apple (paid Apple Developer account). Needs a Services ID as the
# client id, plus a Sign-in-with-Apple key (.p8) identified by Team ID + Key ID.
# Return URL: https://<public-host>/v1/social/apple/callback  (Apple rejects
# http/localhost — use an HTTPS tunnel for local testing). APPLE_PRIVATE_KEY is
# the .p8 contents (may be a single line with \n escapes).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Notifications ─────────────────────────────────────────────────────────
# SMTP (SES/SendGrid/Mailgun/Postmark…). Blank SMTP_HOST in dev = log instead of send.
# For real delivery, set SPF/DKIM/DMARC on the sending domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Qeet ID <noreply@qeet.in>
# Twilio (SMS-OTP). Blank = log instead of send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Billing / card payments ─────────────────────────────────────────────────
# Paid-plan checkout providers (raw REST, no SDK). Each is OFF until its keys are
# set. With none set, a paid-plan checkout is REFUSED (422) rather than granted
# free — unless BILLING_ALLOW_UNPAID_ACTIVATION=true (manual/invoice-only mode).
# Use test-mode keys locally (sk_test_… / rzp_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Provider routing by billing country. Default serves any unlisted country;
# routes is a comma-separated "CC:provider" list. Checkout with no country falls
# back to currency routing (INR → Razorpay, else the default).
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_COUNTRY_ROUTES=IN:razorpay
# Dev/manual: activate a paid plan without collecting payment. Keep false to
# require a real card payment.
BILLING_ALLOW_UNPAID_ACTIVATION=false
# Dev-only sandbox provider: fakes the hosted checkout so "Switch to plan"
# redirects to a local mock page and completes on click — no real account
# needed. Overrides all provider routing. Refused outside SERVICE_ENV=dev.
PAYMENT_SANDBOX=true
# This backend's own origin, used to build the mock-checkout redirect URL.
PAYMENT_SANDBOX_BASE_URL=http://localhost:4001

# ── Scaling ───────────────────────────────────────────────────────────────
# Enables shared cross-replica rate limiting; blank = in-process (single instance only).
# Example: redis://localhost:6379/0  (rediss://… for TLS)
REDIS_URL=

# WebAuthn / passkeys RP. Blank RP_ID/name defaults to the APP_BASE_URL host + SERVICE_NAME.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_DISPLAY_NAME=
# Must list every browser origin that runs a passkey ceremony (console :3002, hosted login :3003).
# A missing origin fails the ceremony with passkey.attestation_invalid even when CORS is fine.
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Dev-only: trust X-Dev-User / X-Dev-Tenant headers (Postman shortcut).
AUTH_DEV_TRUST_HEADERS=true

# ── Qeet AI copilot ───────────────────────────────────────────────────────
# Admin-console copilot. Blank QEETAI_PROVIDER disables it (CRUD still works,
# messages return 409 qeetai_unconfigured).
# PROVIDER: "anthropic" or "openai"; "openai" also drives any OpenAI-compatible endpoint via BASE_URL.
# API_KEY: server-side only, never returned. MODEL: provider model id. BASE_URL: blank = provider default.
#   anthropic  → BASE_URL blank,                              MODEL=claude-sonnet-5
#   openai     → BASE_URL blank,                              MODEL=gpt-4o
#   groq       → BASE_URL=https://api.groq.com/openai/v1,     MODEL=llama-3.1-70b-versatile
#   openrouter → BASE_URL=https://openrouter.ai/api/v1,       MODEL=anthropic/claude-sonnet-5
#   gemini     → BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, MODEL=gemini-2.0-flash
QEETAI_PROVIDER=
QEETAI_API_KEY=
# Blank uses the built-in default (claude-sonnet-5).
QEETAI_MODEL=
QEETAI_MAX_TOKENS=4096
QEETAI_BASE_URL=

# Dev-only:
CSRF_DISABLED=true

# Prod: scope the CSRF cookie across sibling subdomains (e.g. ".id.qeet.in"). Blank in dev.
CSRF_COOKIE_DOMAIN=

# Route tenant-configured outbound HTTP (webhooks, auth hooks, SIEM sinks,
# social/token-vault calls) through a forward proxy. Ambient HTTPS_PROXY is
# ignored on purpose. When set, the proxy resolves destinations and therefore
# owns address filtering; leave blank to keep in-process SSRF IP pinning.
EGRESS_PROXY_URL=
