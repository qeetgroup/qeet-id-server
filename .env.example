# Qeet ID server settings, with their development values. Copy to .env (make dev reads it).
# Blank means the default, or the feature off. The full rules for each setting are in
# internal/platform/config/config.go.

# ── Service ──────────────────────────────────────────────────────────────────────────────────────
# SERVICE_ENV is required: dev (a workstation), local (the Qeet ID Kit, with SERVICE_PROFILE dev,
# test or staging, and every production gate on) or prod. Shutdown waits SHUTDOWN_TIMEOUT at most;
# SHUTDOWN_DRAIN_DELAY lets a load balancer drain the instance first (0 with none in front).
SERVICE_NAME=qeet-id
SERVICE_ENV=dev
SERVICE_PROFILE=
HTTP_PORT=4001
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536
SHUTDOWN_TIMEOUT=20s
SHUTDOWN_DRAIN_DELAY=0s
LOG_LEVEL=info
LOG_FORMAT=json
HOSTING_REGION=

# ── Observability ────────────────────────────────────────────────────────────────────────────────
# Traces go to the OTLP/HTTP collector named (make dev-observed sets it; blank: no tracing).
# PPROF_ADDR serves runtime profiles for Pyroscope, loopback only outside dev. METRICS_TOKEN guards
# /metrics: blank leaves it open in dev and off (404) elsewhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1
PPROF_ADDR=
METRICS_TOKEN=

# ── Database, events and shared state ────────────────────────────────────────────────────────────
# NATS receives the outbox's events (blank: logged only). REDIS_URL shares rate limits across
# replicas (blank: each instance keeps its own).
DB_URL=postgres://postgres:<password>@localhost:5001/qeet_id?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=10
NATS_URL=nats://127.0.0.1:4222
REDIS_URL=

# ── Tokens and sessions ──────────────────────────────────────────────────────────────────────────
# In prod JWT_ISSUER is the https API URL. ACCESS_TOKEN_TTL stays under 15m; the session limits
# apply where an organization's policy sets none. REFRESH_TOKEN_TTL is how long a refresh token
# lasts unused (each renewal starts it again), so an application left unused that long signs in again.
JWT_ISSUER=qeet-id
JWT_AUDIENCE=qeet-id
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_REUSE_GRACE=30s
SESSION_MAX_AGE=720h
SESSION_IDLE_TIMEOUT=24h

# The signing key is a PEM EC P-256 or RSA 2048+ key, required outside dev (make dev sets it from
# .secrets/). To rotate, stage the new key on every replica, then set JWT_ACTIVATE_SIGNING_KEY=true.
JWT_SIGNING_KEY=
JWT_RETIRED_KEYS=
JWT_ACTIVATE_SIGNING_KEY=false
JWT_SIGNING_KEY_RETIRE_GRACE=720h
JWT_SIGNING_KEY_REFRESH_INTERVAL=5s

# ── Keys for stored secrets ──────────────────────────────────────────────────────────────────────
# SECRETS_KEY (openssl rand -base64 32) encrypts every stored secret; required outside dev. To
# rotate, add the new key to SECRETS_PREVIOUS_KEYS everywhere, swap it in, and drop the old one once
# envelope_rows_on_old_keys is 0. With aws-kms, KMS_KEY_ID unwraps SECRETS_WRAPPED_DEK instead.
SECRETS_KEY=
SECRETS_PREVIOUS_KEYS=
SECRETS_PROVIDER=static
KMS_KEY_ID=
SECRETS_WRAPPED_DEK=
SECRETS_PREVIOUS_WRAPPED_DEKS=

# The SAML IdP's signing key and certificate (PEM), required outside dev; make dev sets them.
SAML_IDP_KEY=
SAML_IDP_CERT=

# ── Passwords ────────────────────────────────────────────────────────────────────────────────────
# The breached-password check (HIBP) is off here because it needs network; keep it on elsewhere.
BREACHED_PASSWORD_CHECK=false
BREACHED_PASSWORD_MIN_COUNT=1
BREACHED_PASSWORD_API_URL=

# ── Network ──────────────────────────────────────────────────────────────────────────────────────
# TRUSTED_PROXY_HOPS counts the proxies in front that append to X-Forwarded-For: set it exactly, or
# callers can forge their address. RELAY_KEYS let the console's and hosted login's servers forward a
# client's address. EGRESS_PROXY_URL routes organization-configured outbound calls.
TRUSTED_PROXY_HOPS=0
RELAY_KEYS=
GEO_COUNTRY_HEADER=
GEO_CITY_HEADER=
EGRESS_PROXY_URL=

# ── Browsers and public URLs ─────────────────────────────────────────────────────────────────────
# Browser origins are listed exactly (a wildcard is refused); passkey ceremonies need theirs in
# WEBAUTHN_RP_ORIGINS too. PUBLIC_BASE_URL, this API's own origin, is required in prod.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3000,http://localhost:5173,http://localhost:3005,https://api.qeet.in
APP_BASE_URL=http://localhost:3002
LOGIN_BASE_URL=http://localhost:3003
PUBLIC_BASE_URL=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_DISPLAY_NAME=
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CSRF_COOKIE_DOMAIN=

# ── Sign in with Google, Microsoft, GitHub, Apple (the console's own accounts) ───────────────────
# Each provider is off until its id and secret are set; its callback is
# <API>/v1/social/<name>/callback. Apple needs an https callback and its .p8 key's text.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Email, SMS and push ──────────────────────────────────────────────────────────────────────────
# Email goes by SMTP, or the SES API (ses-api, with AWS_REGION); one is required outside dev, and in
# dev a blank SMTP_HOST logs emails instead. SMS (Twilio) and push (APNs, FCM) are off until set.
EMAIL_PROVIDER=smtp
AWS_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Qeet ID <noreply@qeet.in>
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC_ARN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.qeetgroup.qeetid
APNS_SANDBOX=false
FCM_SERVICE_ACCOUNT=
SALES_EMAIL=sales@qeet.in

# ── Billing ──────────────────────────────────────────────────────────────────────────────────────
# Stripe and Razorpay are each off until set (use test keys locally); with none, a paid checkout is
# refused. Invoice tax is off until the seller's jurisdiction is set (1800 bps = 18% GST).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_COUNTRY_ROUTES=IN:razorpay
BILLING_ALLOW_UNPAID_ACTIVATION=false
BILLING_TAX_ENABLED=false
BILLING_SELLER_COUNTRY=IN
BILLING_SELLER_STATE=
BILLING_GST_RATE_BPS=1800
BILLING_SUPPLIER_GSTIN=
BILLING_SAC=
BILLING_PAYMENT_GRACE=168h

# ── Qeet AI ──────────────────────────────────────────────────────────────────────────────────────
# The console's assistant: anthropic or openai (any OpenAI-compatible endpoint, via
# QEETAI_BASE_URL). Blank provider: off. Blank model: the provider's default.
QEETAI_PROVIDER=
QEETAI_API_KEY=
QEETAI_MODEL=
QEETAI_MAX_TOKENS=4096
QEETAI_BASE_URL=

# ── Development only ─────────────────────────────────────────────────────────────────────────────
# Each is refused outside SERVICE_ENV=dev: trusting X-Dev-User headers, CSRF off, and a fake
# checkout that completes on click.
AUTH_DEV_TRUST_HEADERS=true
CSRF_DISABLED=true
PAYMENT_SANDBOX=true
PAYMENT_SANDBOX_BASE_URL=http://localhost:4001

# ── Development tools (make, docker-compose.yml) ─────────────────────────────────────────────────
# Not read by the server. Set any of these in .env to change its default, shown here:
#   POSTGRES_USER postgres · POSTGRES_PASSWORD password · POSTGRES_DB qeet_id · POSTGRES_PORT 5001
#   NATS_PORT 4222 · MAILPIT_SMTP_PORT 1025 · MAILPIT_UI_PORT 8025
#   GRAFANA_PORT 3300 · PROMETHEUS_PORT 9090 · ALERTMANAGER_PORT 9093 · LOKI_PORT 3100
#   TEMPO_PORT 3200 · PYROSCOPE_PORT 4040 · OTLP_GRPC_PORT 4317 · OTLP_HTTP_PORT 4318
#   DEV_SECRETS_DIR .secrets · DEV_LOG_FILE bin/logs/api.log
#   DBTEST_POSTGRES_IMAGE postgres:16-alpine · DBTEST_POSTGRES_PASSWORD postgres
#   DBTEST_MAX_CONNECTIONS 400 · TEST_TIMEOUT 15m · SHFMT_VERSION v3.14.1
#   GOLANGCI_VERSION · SQLC_VERSION · GOVULNCHECK_VERSION · GOSEC_VERSION · GOSEC_XTOOLS_VERSION
#   GITLEAKS_IMAGE · TRIVY_IMAGE · SCAN_IMAGE_TAG (pinned in cmd/devtool/checks.go)
#   make load: LOAD_BASE_URL http://host.docker.internal:<HTTP_PORT> · LOAD_DURATION 1m · K6_IMAGE
#   make dast, fuzz-api: SCAN_BASE_URL as LOAD_BASE_URL · SCAN_TOKEN (a bearer token) · SCAN_DOCS
#     (all five) · SCAN_EXAMPLES 10 · SCAN_RATE 10/s · ZAP_IMAGE · SCHEMATHESIS_IMAGE
#   make sonar: SONAR_TOKEN (from SonarQube) · SONAR_PORT 9000 · SONAR_HOST_URL · SONAR_SCANNER_IMAGE
