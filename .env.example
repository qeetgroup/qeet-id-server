SERVICE_NAME=qeet-id
# Required, one of: dev | local | prod — unset or anything else refuses to start.
#   dev   developer workstation; production gates off, ephemeral keys allowed
#   local Local-tier runtime of the Qeet ID Kit (qeet-id-kit; DEV/TEST/STAGING);
#         every production gate on, APP_BASE_URL/LOGIN_BASE_URL must be
#         localhost or *.localhost
#   prod  production; APP_BASE_URL must be a public origin
SERVICE_ENV=dev
# Local environment, only with SERVICE_ENV=local: dev | test | staging (else empty).
SERVICE_PROFILE=
HTTP_PORT=4001
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=65536
# The most a stop takes, from SIGTERM to exit (20s by default; 5s..2m). Give the
# container longer to stop, e.g. docker stop -t 30 or stop_grace_period: 30s.
SHUTDOWN_TIMEOUT=20s
# How long a stopping server answers /readyz 503 before it stops taking
# requests, so a load balancer drains it first (5s by default; 0..30s and at
# most half of SHUTDOWN_TIMEOUT). 0 here, with no load balancer in front.
SHUTDOWN_DRAIN_DELAY=0s
LOG_LEVEL=info
# "json" forces JSON lines (pipe through jq for pretty-print); "text" forces colored logfmt; blank = auto.
LOG_FORMAT=json

# ── OpenTelemetry tracing (OTLP/HTTP) ─────────────────────────────────────────
# Blank disables tracing entirely: no exporter, no network, global no-op tracer.
# To export, give the collector's base URL (http://localhost:4318: /v1/traces is added, as the
# OTLP specification reads this variable) or a full traces URL, which is used as it is.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling ratio for root spans, 0..1. Keep 1 locally so every request is
# traced; lower it in staging/prod.
OTEL_TRACES_SAMPLER_RATIO=1
# Continuous profiling: serve Go's runtime profiles on this address (its own listener, never the API's)
# for Grafana Alloy to scrape into Pyroscope. Blank serves nothing; outside dev it must be loopback.
# make dev-observed sets 0.0.0.0:6060 so the local stack's Alloy container can reach it.
PPROF_ADDR=

# Postgres connection string (matches docker-compose.yml); used for queries + migrations.
DB_URL=postgres://postgres:<password>@localhost:5001/qeet_id?sslmode=disable
# Outbox dispatcher publishes domain events here; blank = log-only.
NATS_URL=nats://127.0.0.1:4222
DB_MIN_CONNS=2
DB_MAX_CONNS=10

# In prod it must be the https URL relying parties see, e.g. https://api.id.qeet.in.
JWT_ISSUER=qeet-id
JWT_AUDIENCE=qeet-id
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
# A refresh token sent again within this long of its rotation gets the pair the
# rotation issued (two instances renewing at once, or a lost answer); later, it
# ends the session as theft. 0 turns it off; at most 1m.
REFRESH_TOKEN_REUSE_GRACE=30s
# Session bounds where an organization's security policy sets none (and for
# accounts with no organization): a session ends SESSION_MAX_AGE after sign-in
# however active it is (1h..8760h; also bounds an application's grant), and
# once it goes SESSION_IDLE_TIMEOUT without a renewal (15m..SESSION_MAX_AGE).
# ACCESS_TOKEN_TTL must stay under 15m, the shortest idle timeout.
SESSION_MAX_AGE=720h
SESSION_IDLE_TIMEOUT=24h
# Private key (PEM) that signs tokens: EC P-256 signs ES256, RSA of 2048 bits or
# more signs RS256, which OpenID Connect requires a provider to support. REQUIRED
# outside dev; `make dev` sets it from .secrets/. Blank in dev = the database's
# active key, or a new one only when the database has none (it is never replaced
# at a restart; with SECRETS_KEY blank too, the next start can't open it and
# refuses to start).
#   Generate: openssl ecparam -name prime256v1 -genkey -noout   (ES256)
#         or: openssl genrsa 2048                               (RS256)
JWT_SIGNING_KEY=
# Concatenated PEM public keys of retired signing keys, kept verifiable during rotation.
JWT_RETIRED_KEYS=
# Two-phase rotation: pre-stage the new JWT_SIGNING_KEY with false on all replicas,
# then set true to atomically activate it in the shared registry. Nothing else
# activates a configured key over the active one.
JWT_ACTIVATE_SIGNING_KEY=false
JWT_SIGNING_KEY_RETIRE_GRACE=720h
JWT_SIGNING_KEY_REFRESH_INTERVAL=5s
# base64 AES key (16/24/32 bytes) that encrypts every stored secret. Blank in dev = ephemeral;
# REQUIRED outside dev. Generate: openssl rand -base64 32
SECRETS_KEY=
# Earlier keys, base64, comma-separated: they decrypt what they sealed, never encrypt.
# Every stored value names the key that sealed it, so rotating loses nothing:
#  1. With several instances, first add the new key here on all of them, so each can read
#     what the others will seal with it.
#  2. Make the new key SECRETS_KEY and move the old one here. New values are sealed with the
#     new key; the secrets-reencrypt job re-seals the stored ones in the background.
#  3. When envelope_rows_on_old_keys is 0 for every column and the audit-chain-verify job has
#     run since (it signs the audit checkpoints again with the new key), remove the old key.
# With aws-kms the steps are the same with SECRETS_WRAPPED_DEK and SECRETS_PREVIOUS_WRAPPED_DEKS;
# a key moved from static to aws-kms stays readable here.
SECRETS_PREVIOUS_KEYS=
# Where the vault key comes from: static (SECRETS_KEY) or aws-kms (KMS_KEY_ID unwraps
# SECRETS_WRAPPED_DEK, the base64 output of `aws kms generate-data-key`, at startup).
SECRETS_PROVIDER=static
KMS_KEY_ID=
SECRETS_WRAPPED_DEK=
# aws-kms only: earlier SECRETS_WRAPPED_DEK values, comma-separated, kept to decrypt (as above).
SECRETS_PREVIOUS_WRAPPED_DEKS=
# SAML IdP signing key and certificate (PEM). REQUIRED outside dev; `make dev` sets them
# from .secrets/. Blank in dev = an ephemeral pair, so SPs re-import metadata after a restart.
SAML_IDP_KEY=
SAML_IDP_CERT=

# Breached-password check (HIBP range API). On by default; off in this development
# template because it needs network. It fails open: an outage allows the password,
# logged and counted in breached_password_check_allowed_on_error_total. Keep it on
# outside dev. An offline common-password denylist always runs.
BREACHED_PASSWORD_CHECK=false
BREACHED_PASSWORD_MIN_COUNT=1
# Pwned Passwords base URL; blank = the public api.pwnedpasswords.com.
BREACHED_PASSWORD_API_URL=

# Number of reverse proxies in front of this server that APPEND to
# X-Forwarded-For (Caddy, nginx and ALB all append rather than replace).
#
# This decides how the client IP is resolved, and the client IP keys the per-IP
# login rate limiter and every audit record. X-Forwarded-For is caller-supplied,
# so the value is read POSITIONALLY from the right: the last N entries are the
# ones your proxies added, and the entry left of them is the real client.
#
#   0  (default, safe)  ignore X-Forwarded-For; use the transport peer.
#   1                   exactly one proxy (the usual single Caddy/nginx/ALB).
#
# Leave 0 when the process is reachable directly. Behind a proxy you MUST set
# the real hop count: too low and callers can forge their IP (bypassing the
# login limiter and forging audit entries); too high and every request is
# attributed to the proxy.
TRUSTED_PROXY_HOPS=0
# Keys (comma-separated, each >= 32 chars) that first-party relays present so
# the client address they forward is trusted: the console's and hosted login's
# servers call the API for a person and send X-Qeet-Relay-Key + X-Qeet-Client-IP.
# Without a match the forwarded address is ignored. Empty: no relay is trusted,
# and every relayed person shares the relay's address (rate limits, lockout,
# address rules, audit). Generate: openssl rand -base64 32
RELAY_KEYS=
# Bearer token a metrics scraper presents for /metrics. Blank = /metrics is open
# in development and off (404) everywhere else. Generate: openssl rand -base64 32
METRICS_TOKEN=
# Header a trusted proxy sets to the client's country (e.g. CF-IPCountry), used by
# risk checks and sessions. Blank = no country; there is no server-side GeoIP.
GEO_COUNTRY_HEADER=
# The header the same proxy sets to the client's city (e.g. CloudFront-Viewer-City), kept on audit events and sessions.
GEO_CITY_HEADER=

# Browser origins allowed to call the API cross-origin (CORS).
#
# Includes the Qeet Developers portal (api.qeet.in) so its API reference can
# send requests to this server from a browser. Without it the portal's "Send"
# fails with "Failed to fetch" even though curl and Postman get 200 — those are
# not browsers and are not subject to the same-origin policy.
#   · https://api.qeet.in    the deployed portal
#   · http://localhost:3005  the portal run locally (`bun run dev`)
#
# A wildcard is rejected at startup: this API enables credentialed CORS, where
# `*` would let any site make authenticated requests. List origins explicitly.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3000,http://localhost:5173,http://localhost:3005,https://api.qeet.in

# Origin for links in emails. Dev: admin app (:3002) hosts /invite/accept.
APP_BASE_URL=http://localhost:3002

# Hosted login app origin — the OAuth authorize flow redirects here.
LOGIN_BASE_URL=http://localhost:3003

# This API's own public origin, e.g. https://api.id.qeet.in. Every absolute URL
# the API returns is built on it (SAML, OIDC discovery, SCIM, OAuth callbacks).
# Required in prod; blank elsewhere = taken from each request's Host.
PUBLIC_BASE_URL=

# Receives in-app "Contact sales" lead notifications.
SALES_EMAIL=sales@qeet.in

# ── Platform social login (console's own Qeet ID accounts, organization-less) ─────
# "Continue with Google" on the console sign-in/sign-up. OFF until both are set.
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and add
# this authorized redirect URI: http://localhost:4001/v1/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra) app registration; add redirect URI (type "Web"):
# http://localhost:4001/v1/social/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# GitHub OAuth App (Settings → Developer settings → OAuth Apps → New). Set the
# Authorization callback URL to: http://localhost:4001/v1/social/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Apple (paid Apple Developer account). Needs a Services ID as the
# client id, plus a Sign-in-with-Apple key (.p8) identified by Team ID + Key ID.
# Return URL: https://<public-host>/v1/social/apple/callback  (Apple rejects
# http/localhost — use an HTTPS tunnel for local testing). APPLE_PRIVATE_KEY is
# the .p8 contents (may be a single line with \n escapes).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Notifications ─────────────────────────────────────────────────────────
# smtp (default), or ses-api for regions with the SES API but no SMTP endpoint: it
# uses the AWS credential chain and AWS_REGION, and only SMTP_FROM of the SMTP settings.
EMAIL_PROVIDER=smtp
AWS_REGION=
# The region this deployment runs in: every organization is created in it and shows it as
# its region (it isn't a per-organization data-residency choice). Empty = AWS_REGION, else us-east-1.
HOSTING_REGION=
# SMTP (SES/SendGrid/Mailgun/Postmark…). Blank SMTP_HOST in dev = log instead of send.
# Outside dev an email provider is required to start: SMTP_HOST and SMTP_FROM, or
# EMAIL_PROVIDER=ses-api with SMTP_FROM and AWS_REGION.
# For real delivery, set SPF/DKIM/DMARC on the sending domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Qeet ID <noreply@qeet.in>
# SES delivery events (EMAIL_PROVIDER=ses-api). Every email names this
# configuration set; its event destination publishes deliveries, bounces and
# complaints to SNS, which posts them to /v1/webhooks/ses. Only the topics in
# SES_EVENTS_TOPIC_ARN (comma-separated) are accepted; blank = endpoint off.
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC_ARN=
# Twilio (SMS-OTP). Blank = log instead of send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Native push for the Qeet ID apps (each off until set). APNS_AUTH_KEY is the .p8 key's PEM text;
# FCM_SERVICE_ACCOUNT is the Firebase service-account JSON.
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.qeetgroup.qeetid
APNS_SANDBOX=false
FCM_SERVICE_ACCOUNT=

# ── Billing / card payments ─────────────────────────────────────────────────
# Paid-plan checkout providers (raw REST, no SDK). Each is OFF until its keys are
# set. With none set, a paid-plan checkout is REFUSED (422) rather than granted
# free — unless BILLING_ALLOW_UNPAID_ACTIVATION=true (manual/invoice-only mode).
# Use test-mode keys locally (sk_test_… / rzp_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Provider routing by billing country. Default serves any unlisted country;
# routes is a comma-separated "CC:provider" list. Checkout with no country falls
# back to currency routing (INR → Razorpay, else the default).
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_COUNTRY_ROUTES=IN:razorpay
# Dev/manual: activate a paid plan without collecting payment. Keep false to
# require a real card payment.
BILLING_ALLOW_UNPAID_ACTIVATION=false
# Dev-only sandbox provider: fakes the hosted checkout so "Switch to plan"
# redirects to a local mock page and completes on click — no real account
# needed. Overrides all provider routing. Refused outside SERVICE_ENV=dev.
PAYMENT_SANDBOX=true
# This backend's own origin, used to build the mock-checkout redirect URL.
PAYMENT_SANDBOX_BASE_URL=http://localhost:4001
# Invoice tax. Off until the operator sets their registered jurisdiction; in India
# BILLING_SELLER_STATE decides CGST+SGST (same state) vs IGST. 1800 bps = 18%.
BILLING_TAX_ENABLED=false
BILLING_SELLER_COUNTRY=IN
BILLING_SELLER_STATE=
BILLING_GST_RATE_BPS=1800
# Printed on every invoice: the seller's GSTIN and the services accounting code (SAC) of what it sells.
BILLING_SUPPLIER_GSTIN=
BILLING_SAC=
# How long an open invoice may go unpaid: a renewal still unpaid this long after its period ends ends the subscription.
BILLING_PAYMENT_GRACE=168h

# ── Scaling ───────────────────────────────────────────────────────────────
# Enables shared cross-replica rate limiting; blank = in-process (single instance only).
# Example: redis://localhost:6379/0  (rediss://… for TLS)
REDIS_URL=

# WebAuthn / passkeys RP. Blank RP_ID/name defaults to the APP_BASE_URL host + SERVICE_NAME.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_DISPLAY_NAME=
# Must list every browser origin that runs a passkey ceremony (console :3002, hosted login :3003).
# A missing origin fails the ceremony with passkey.attestation_invalid even when CORS is fine.
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Dev-only: trust X-Dev-User / X-Dev-Organization headers (Postman shortcut).
AUTH_DEV_TRUST_HEADERS=true

# ── Qeet AI copilot ───────────────────────────────────────────────────────
# Admin-console copilot. Blank QEETAI_PROVIDER disables it (CRUD still works,
# messages return 409 qeetai_unconfigured).
# PROVIDER: "anthropic" or "openai"; "openai" also drives any OpenAI-compatible endpoint via BASE_URL.
# API_KEY: server-side only, never returned. MODEL: provider model id. BASE_URL: blank = provider default.
#   anthropic  → BASE_URL blank,                              MODEL=claude-sonnet-5
#   openai     → BASE_URL blank,                              MODEL=gpt-4o
#   groq       → BASE_URL=https://api.groq.com/openai/v1,     MODEL=llama-3.1-70b-versatile
#   openrouter → BASE_URL=https://openrouter.ai/api/v1,       MODEL=anthropic/claude-sonnet-5
#   gemini     → BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, MODEL=gemini-2.0-flash
QEETAI_PROVIDER=
QEETAI_API_KEY=
# Blank uses the built-in default (claude-sonnet-5).
QEETAI_MODEL=
QEETAI_MAX_TOKENS=4096
QEETAI_BASE_URL=

# Dev-only:
CSRF_DISABLED=true

# Prod: scope the CSRF cookie across sibling subdomains (e.g. ".id.qeet.in"). Blank in dev.
CSRF_COOKIE_DOMAIN=

# Route organization-configured outbound HTTP (webhooks, auth hooks, SIEM sinks,
# social/token-vault calls) through a forward proxy. Ambient HTTPS_PROXY is
# ignored on purpose. When set, the proxy resolves destinations and therefore
# owns address filtering; leave blank to keep in-process SSRF IP pinning.
EGRESS_PROXY_URL=

# ── Development tooling (make / go run ./cmd/devtool, and docker-compose.yml) ─────────────────────
# Not read by the server: devtool and Docker Compose read these when you set them here or in your
# shell, and use the default shown otherwise. To change one, add a NAME=value line to your .env.
#   POSTGRES_USER postgres · POSTGRES_PASSWORD password · POSTGRES_DB qeet_id · POSTGRES_PORT 5001
#     (the local database; keep DB_URL above in step)
#   NATS_PORT 4222 · MAILPIT_SMTP_PORT 1025 · MAILPIT_UI_PORT 8025
#   GRAFANA_PORT 3300 · PROMETHEUS_PORT 9090 · ALERTMANAGER_PORT 9093 · LOKI_PORT 3100
#   TEMPO_PORT 3200 · PYROSCOPE_PORT 4040 · OTLP_GRPC_PORT 4317 · OTLP_HTTP_PORT 4318
#     (the local observability stack, make obs-up; Prometheus scrapes the API on :4001, see
#     observability/prometheus/prometheus.yml if HTTP_PORT changes)
#   DEV_SECRETS_DIR .secrets · DEV_LOG_FILE bin/logs/api.log (make dev / dev-observed)
#   DBTEST_POSTGRES_IMAGE postgres:16-alpine · DBTEST_POSTGRES_PASSWORD postgres
#   DBTEST_MAX_CONNECTIONS 400 · TEST_TIMEOUT 15m (make test-db)
#   GOLANGCI_VERSION · SQLC_VERSION · GOVULNCHECK_VERSION · GOSEC_VERSION · GOSEC_XTOOLS_VERSION
#   GITLEAKS_IMAGE · TRIVY_IMAGE · SCAN_IMAGE_TAG (pinned in cmd/devtool/checks.go, in step with CI)
